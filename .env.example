MAS_HOST=127.0.0.1
MAS_PORT=8000
MAS_OUTPUT_DIR=outputs
MAS_DB_PATH=data/mas_finance.db
MAS_API_KEY=
MAS_ALLOW_NETWORK=false
MAS_MARKET_DATA_PROVIDER=offline
MAS_SEC_USER_AGENT=
FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org
MAS_CONVERSATION_MEMORY_ENABLED=true
MAS_CONVERSATION_CONTEXT_TOKENS=300000
MAS_CONVERSATION_RECENT_TOKENS=20000
MAS_AUTOMATIC_MEMORY_CONSOLIDATION_ENABLED=true
# 可选：由用户主动维护的 UTF-8 Markdown 长期指令，作为独立用户配置层注入。
MAS_USER_PROFILE_PATH=
MAS_PERSONAL_MEMORY_ENABLED=true
MAS_PERSONAL_KNOWLEDGE_ENABLED=true
MAS_MAX_PERSONAL_KNOWLEDGE_DOCUMENTS=100
MAS_SESSION_DOCUMENT_TTL_SECONDS=3600
MAS_MAX_SESSION_DOCUMENT_SESSIONS=100
MAS_MAX_PDF_PAGES=500
MAS_MAX_PDF_TEXT_CHARACTERS=5000000
MAS_PLANNING_EVIDENCE_CHARACTERS=24000
MAS_SYNTHESIS_EVIDENCE_CHARACTERS=48000
MAS_SYNTHESIS_OUTPUT_TOKENS=4096

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=45

# Optional operator inventory. The current runtime reads only DEEPSEEK_*;
# these named profiles are not automatic fallbacks.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.6-plus
DEEPSEEK_FLASH_API_KEY=
DEEPSEEK_FLASH_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

PADDLEOCR_ACCESS_TOKEN=
PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
BRAVE_SEARCH_API_KEY=
BOCHA_SEARCH_API_KEY=
MAS_EMBEDDING_ENDPOINT=
MAS_EMBEDDING_MODEL=
MAS_EMBEDDING_API_KEY=
MAS_EMBEDDING_TIMEOUT_SECONDS=30

# Optional MCP host allowlist. JSON array; empty disables extra MCP clients.
# Each server is stdio (local command) or https (fixed URL, no credentials in the URL).
# Tools must declare read-only and return a canonical EvidenceBundle; side-effecting tools are dropped.
# Planner sees mcp.search_tools / mcp.describe_tool / mcp.call_tool plus a short index, not full schemas.
# MAS_MCP_SERVERS=[{"name":"localpolicy","transport":"stdio","command":"python","args":["-u","tests/mcp_stdio_fixture.py"],"default_capability":"document.search","network_access":false,"max_calls_per_minute":6}]
MAS_MCP_SERVERS=

# Optional AllTick / 必盈行情 MCP（配置任一密钥即自动挂载 extmarket stdio server）
ALLTICK_TOKEN=
BIYING_LICENCE=
MAS_ENABLE_YFINANCE=false
MAS_ENABLE_AKSHARE=false
FRED_MAX_CALLS_PER_MINUTE=8
BOCHA_MAX_CALLS_PER_MINUTE=6
BRAVE_MAX_CALLS_PER_MINUTE=6
MAS_MARKET_MAX_CALLS_PER_MINUTE=6

# Local BGE-M3 via vLLM (scripts/bge_m3_service.sh)
# MAS_EMBEDDING_ENDPOINT=http://127.0.0.1:8001/v1/embeddings
# MAS_EMBEDDING_MODEL=BAAI/bge-m3
