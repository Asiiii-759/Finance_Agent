# Finance_RAG runtime configuration

# mock: deterministic local fake vectors for smoke tests.
# dashscope: Aliyun Bailian text-embedding-v4 via OpenAI-compatible API.
FINANCE_RAG_EMBEDDING_PROVIDER=dashscope

# DashScope / Aliyun Bailian
DASHSCOPE_API_KEY=sk-xxxxxxxx
FINANCE_RAG_EMBEDDING_MODEL=text-embedding-v4
FINANCE_RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
FINANCE_RAG_EMBEDDING_DIMENSIONS=1024
FINANCE_RAG_EMBEDDING_BATCH_SIZE=10
FINANCE_RAG_EMBEDDING_TIMEOUT=120
FINANCE_RAG_EMBEDDING_MAX_RETRIES=3

# FAISS device.
# Keep cpu for portable smoke tests.
# Set to gpu inside WSL2/Linux FinAgent after installing faiss-gpu.
FINANCE_RAG_FAISS_DEVICE=cpu
FINANCE_RAG_FAISS_GPU_ID=0

# Optional rerank route.
# DASHSCOPE_API_KEY=sk-xxxxxxxx
# FINANCE_RAG_RERANK_MODEL=qwen3-rerank
